# Optional non-secret overrides. Prefer active-profile config.yaml.
# Copying this file does not enable carryover or modify any gateway.
HANDYDANDY_MODE=advise
HANDYDANDY_MAX_INPUT_TOKENS=100000
HANDYDANDY_MAX_MESSAGES=60
# Percentage threshold needs a positive explicit model context window.
HANDYDANDY_CONTEXT_LIMIT=0
HANDYDANDY_CONTEXT_FRACTION=0.5
# Empty uses the active profile's handoffs directory.
HANDYDANDY_HANDOFF_DIR=
# Empty disables the optional CSV.
HANDYDANDY_SESSION_LOG_CSV=
